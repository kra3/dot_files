  # pie instance orgs
  AI-for-Devs-Community/*: ~/src/pie/AI-for-Devs-Community/*
  CanadaTC/*: ~/src/pie/CanadaTC/*
  CloudTech/*: ~/src/pie/CloudTech/*
  devprodeng/*: ~/src/pie/devprodeng/*
  devpubs-eng/*: ~/src/pie/devpubs-eng/*
  frontend/*: ~/src/pie/frontend/*
  icloud-web/*: ~/src/pie/icloud-web/*
  Radar/*: ~/src/pie/Radar/*
  splunk-sre/*: ~/src/pie/splunk-sre/*

  # github.com orgs
  aws/*: ~/src/public/aws/*
  aws-cloudformation/*: ~/src/public/aws-cloudformation/*
  awslabs/*: ~/src/public/awslabs/*
  copyleftdev/*: ~/src/public/copyleftdev/*
