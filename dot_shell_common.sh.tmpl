#!/usr/bin/env bash
# Common shell configuration for both bash and zsh
# Sourced by ~/.bashrc and ~/.zshrc

# ============================================================================
# Environment Variables
# ============================================================================

{{- if eq .chezmoi.os "darwin" }}
export EDITOR="/opt/homebrew/bin/vim"
{{- else }}
export EDITOR="vim"
{{- end }}

export LANG=en_US.UTF-8
export LC_ALL=$LANG
export LC_CTYPE=$LANG

# Ensure gpg pinentry can talk to the current terminal
if command -v gpg >/dev/null 2>&1 && [[ -t 1 ]]; then
    export GPG_TTY="$(tty)"
fi

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Detect Homebrew prefix (works on both Apple Silicon and Intel Macs)
if [[ -z "$BREW_PREFIX" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        BREW_PREFIX="/opt/homebrew"
    elif [[ -x /usr/local/bin/brew ]]; then
        BREW_PREFIX="/usr/local"
    else
        BREW_PREFIX="$(brew --prefix 2>/dev/null)"
    fi
fi

# Color configuration for ls
# Use vivid for modern, maintainable LS_COLORS (if available)
if command -v vivid &> /dev/null; then
    export LS_COLORS="$(vivid generate catppuccin-mocha)"
else
    # Fallback to reasonable defaults
    export LS_COLORS='di=34:ln=36:so=35:pi=33:ex=32:bd=33:cd=33:su=31:sg=31:tw=34:ow=34'
fi

# Quick cd to common directories
# Note: Not exported to avoid breaking scripts that use 'cd'
# CDPATH only affects interactive cd commands in your shell
CDPATH=.:~:~/src

# Pager configuration
export PAGER="less"
export LESS="-R -F -X -i"  # Raw colors, quit if one screen, no init, case-insensitive
if [[ -n "$BREW_PREFIX" && -x "$BREW_PREFIX/bin/lesspipe.sh" ]]; then
    export LESSOPEN="|$BREW_PREFIX/bin/lesspipe.sh %s"
fi

# Python configuration
export PYENV_ROOT="$HOME/.pyenv"
export PIP_REQUIRE_VIRTUALENV=true  # Prevent accidental system-wide pip installs

# FZF configuration
# Prefer fd (modern find) over rg for file listing - fd is faster and more versatile
# fd respects .gitignore and .fdignore by default
if command -v fd &> /dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
elif command -v fdfind &> /dev/null; then
    export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
elif command -v rg &> /dev/null; then
    # Fallback to ripgrep if fd not available
    export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# Gradle configuration
export GRADLE_COMPLETION_UNQUALIFIED_TASKS="true"

# NVM
export NVM_DIR="$HOME/.nvm"

# ============================================================================
# PATH Configuration
# ============================================================================

# Helper function to add to PATH (avoids duplicates)
_add_to_path() {
    local dir="$1"
    local position="${2:-prepend}"  # prepend or append

    # Only add if directory exists
    if [[ -d "$dir" ]]; then
        # Remove existing occurrences to maintain ordering guarantees
        local sanitized=":$PATH:"
        sanitized="${sanitized//:$dir:/:}"
        sanitized="${sanitized//::/:}"
        sanitized="${sanitized#:}"
        sanitized="${sanitized%:}"
        PATH="$sanitized"

        if [[ "$position" == "append" ]]; then
            PATH="${PATH:+$PATH:}$dir"
        else
            PATH="$dir${PATH:+:$PATH}"
        fi
    fi
}

# Priority paths (prepend - highest priority first)
_add_to_path "$HOME/bin"
_add_to_path "$HOME/.local/bin"

# Homebrew (works on both Apple Silicon and Intel Macs)
if [[ -n "$BREW_PREFIX" ]]; then
    _add_to_path "$BREW_PREFIX/bin"
    _add_to_path "$BREW_PREFIX/sbin"
    _add_to_path "$BREW_PREFIX/opt/libpq/bin"  # PostgreSQL client tools
fi

# Version managers
_add_to_path "$HOME/.jenv/bin"  # jenv (Java)

# Language-specific package managers
_add_to_path "$HOME/.yarn/bin"
_add_to_path "$HOME/.config/yarn/global/node_modules/.bin"

# Development tools (append - lower priority)
_add_to_path "$HOME/Library/Application Support/Coursier/bin" append
_add_to_path "$HOME/.local/share/coursier/bin" append
_add_to_path "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" append
_add_to_path "$HOME/.local/share/JetBrains/Toolbox/scripts" append

# Clean up helper function
unset -f _add_to_path

# Export PATH
export PATH

# ============================================================================
# Aliases
# ============================================================================

# System
if [[ $(uname -s) = Darwin ]]; then
    alias brewup='brew update; brew upgrade; brew cleanup; brew doctor'
fi

# Modern CLI tools - eza, bat, ripgrep
alias ls='eza'
alias l='eza -F'
alias ll='eza -lhF --git'
alias la='eza -lhaF --git'
alias lla='eza -al --git'
alias lsd='eza -lD'  # List only directories
alias tree='eza --tree'

alias cat='bat --paging=never'
alias less='bat --paging=always'

# Note: ripgrep (rg) has different flags than grep
# Don't alias grep='rg' as it breaks scripts expecting POSIX grep
# Use rg directly for better performance and features

# fd - modern find
# On Debian/Ubuntu, fd is installed as 'fdfind' to avoid conflict with another package
if ! command -v fd &> /dev/null && command -v fdfind &> /dev/null; then
    alias fd='fdfind'
fi

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias -- -="cd -"

# Safety
alias rm='rm -iv'
alias cp='cp -v'
alias mv='mv -v'

# Utilities
alias cls='clear'
if command -v vim > /dev/null 2>&1; then
    alias vi="$(command -v vim)"
fi
alias h='history'
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%T"'
alias today='date +"%d-%m-%Y"'
alias mount='mount | column -t'

# Git
alias g='git'

# Diff
if command -v colordiff > /dev/null 2>&1; then
    alias diff='colordiff'
fi

# Gradle wrapper
alias gradle='gw'

# Python install with framework on macOS
alias pyenvinstall='env PYTHON_CONFIGURE_OPTS="--enable-framework" pyenv install'

{{- if eq .chezmoi.os "darwin" }}
# macOS-specific: List Java versions
alias macjava='/usr/libexec/java_home -V'
{{- end }}

# ============================================================================
# Functions
# ============================================================================

# Calculator function (use: calc 2+2)
calc() { echo "$*" | bc -l; }

# Note-taking with vimwiki
n() {
    # Open vimwiki index in vim
    vim -c "VimwikiIndex"
}

# ============================================================================
# Tool Initializations
# ============================================================================

# jenv (Java version manager)
if command -v jenv &> /dev/null; then
    eval "$(jenv init -)"
fi

# pyenv (Python version manager)
if command -v pyenv &> /dev/null; then
    eval "$(pyenv init -)"
    # Only initialize virtualenv if in bash (zsh doesn't need it)
    if [ -n "$BASH_VERSION" ]; then
        eval "$(pyenv virtualenv-init -)"
    fi
fi

# nvm (Node Version Manager) - Lazy loading for performance
# nvm is slow to load, so we lazy-load it when first needed
if [[ -n "$BREW_PREFIX" && -s "$BREW_PREFIX/opt/nvm/nvm.sh" ]]; then
    # Set NVM_DIR but don't load nvm yet
    export NVM_DIR="$HOME/.nvm"

    # Create lazy-loading wrapper functions
    nvm() {
        unset -f nvm node npm npx
        # Now load nvm
        [ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ] && source "$BREW_PREFIX/opt/nvm/nvm.sh"
        # Load bash completion if in bash
        if [ -n "$BASH_VERSION" ]; then
            [ -s "$BREW_PREFIX/opt/nvm/bash_completion.d/nvm" ] && source "$BREW_PREFIX/opt/nvm/bash_completion.d/nvm"
        elif [ -n "$ZSH_VERSION" ]; then
            [ -s "$BREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && source "$BREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
        fi
        # Execute the actual nvm command
        nvm "$@"
    }

    # Lazy-load for node, npm, npx too
    node() {
        unset -f nvm node npm npx
        [ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ] && source "$BREW_PREFIX/opt/nvm/nvm.sh"
        node "$@"
    }

    npm() {
        unset -f nvm node npm npx
        [ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ] && source "$BREW_PREFIX/opt/nvm/nvm.sh"
        npm "$@"
    }

    npx() {
        unset -f nvm node npm npx
        [ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ] && source "$BREW_PREFIX/opt/nvm/nvm.sh"
        npx "$@"
    }
fi

# zoxide - smart cd
if command -v zoxide &> /dev/null; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(zoxide init zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(zoxide init bash)"
    fi
fi

# fzf - fuzzy finder
if [ -n "$BASH_VERSION" ]; then
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
elif [ -n "$ZSH_VERSION" ]; then
    [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

# ============================================================================
# Tmux Functions
# ============================================================================

# Sesh integration - quick session connect
ts() {
    if [ -z "$1" ]; then
        # Interactive mode with fzf
        if command -v sesh &> /dev/null && command -v fzf &> /dev/null; then
            local session
            session=$(sesh list -i | perl -pe 's/\\u\{([0-9a-f]+)\}/chr(hex($1))/gie' | fzf --height 40% --reverse --border --prompt '⚡ ' \
                --color 'fg:#cdd6f4,bg:#1e1e2e,hl:#cba6f7' \
                --color 'fg+:#cdd6f4,bg+:#313244,hl+:#cba6f7' \
                --color 'info:#89b4fa,prompt:#cba6f7,pointer:#f38ba8')
            [ -n "$session" ] && sesh connect "$session"
        else
            echo "sesh or fzf not found. Install with: brew install sesh fzf"
        fi
    else
        # Direct mode with session name/path
        sesh connect "$1"
    fi
}

# Quick tmux session for current directory
tn() {
    local session_name="${1:-$(basename "$PWD")}"
    tmux new-session -A -s "$session_name"
}

# Kill tmux session with fzf
tk() {
    if [ -z "$1" ]; then
        local session
        session=$(tmux list-sessions -F '#S' | fzf --height 40% --reverse --prompt 'Kill session: ')
        [ -n "$session" ] && tmux kill-session -t "$session"
    else
        tmux kill-session -t "$1"
    fi
}

# Tmux session switcher (works from inside tmux)
tw() {
    if [ -n "$TMUX" ]; then
        local session current_session
        current_session=$(tmux display-message -p '#S')
        session=$(tmux list-sessions -F '#S' | command grep -v "^${current_session}$" | fzf --height 40% --reverse --prompt 'Switch to: ')
        [ -n "$session" ] && tmux switch-client -t "$session"
    else
        echo "Not in a tmux session"
    fi
}

# Tmux window switcher (works from inside tmux)
twd() {
    if [ -n "$TMUX" ]; then
        local window
        window=$(tmux list-windows -a -F '#S:#I:#W' | fzf --height 40% --reverse --prompt 'Go to window: ')
        [ -n "$window" ] && tmux switch-client -t "$(echo "$window" | awk -F: '{print $1":"$2}')"
    else
        echo "Not in a tmux session"
    fi
}

# List all tmux sessions with colors
tls() {
    if command -v tmux &> /dev/null; then
        echo "Active tmux sessions:"
        tmux list-sessions 2>/dev/null || echo "No active sessions"
    fi
}

# Shortcut to edit tmux config
tedit() {
    ${EDITOR:-vim} ~/.tmux/.tmux.conf
}

# Reload tmux config from outside tmux
treload() {
    tmux source-file ~/.tmux/.tmux.conf
    echo "Tmux config reloaded"
}

# ============================================================================
# Worktree Development Functions
# ============================================================================

# Git worktree + tmux session for feature development
# Usage: wt [flags] <branch-name>
wt() {
    local branch="" action="create" force_new=false force_checkout=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--new) force_new=true; shift ;;
            -c|--checkout) force_checkout=true; shift ;;
            -d|--delete) action="delete"; shift ;;
            -l|--list) action="list"; shift ;;
            -h|--help) _wt_help; return 0 ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) branch="$1"; shift ;;
        esac
    done

    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not in a git repository" >&2
        return 1
    fi

    [[ "$action" == "list" ]] && { git worktree list; return 0; }
    [[ -z "$branch" ]] && { echo "Error: Branch name required" >&2; _wt_help >&2; return 1; }

    local repo_root repo_name default_branch
    repo_root=$(git rev-parse --show-toplevel)
    repo_name=$(basename "$repo_root")
    default_branch=$(_wt_get_default_branch)

    # Normalize branch name to <default>.<feature> format
    local normalized_branch
    normalized_branch=$(_wt_normalize_branch "$branch" "$default_branch")

    # Worktree path and name
    local worktree_name="${repo_name}-${normalized_branch}"
    local worktree_path="$HOME/src/worktrees/${worktree_name}"

    # Window name: just the branch input (session already identifies repo)
    local window_name="$branch"

    # For delete, check if worktree exists; if not, try the raw branch input
    if [[ "$action" == "delete" ]]; then
        if [[ ! -d "$worktree_path" ]]; then
            # Try with raw branch name (user may have passed full branch name)
            worktree_name="${repo_name}-${branch}"
            worktree_path="$HOME/src/worktrees/${worktree_name}"
        fi
        _wt_delete "$worktree_path" "$normalized_branch" "$window_name"
        return $?
    fi

    _wt_create "$normalized_branch" "$worktree_path" "$window_name" "$force_new" "$force_checkout" "$repo_root" "$default_branch"
}

# Normalize branch name to <default>.<feature> format
# Examples: "foobar" -> "main.foobar", "feature/bar" -> "main.bar", "main.bar" -> "main.bar"
_wt_normalize_branch() {
    local input="$1"
    local default_branch="$2"
    local feature

    # If already in <default>.<something> format, return as-is
    if [[ "$input" == "${default_branch}."* ]]; then
        echo "$input"
        return
    fi

    # Strip common prefixes (feature/, bugfix/, hotfix/, fix/, etc.)
    feature=$(echo "$input" | sed -E 's/^(feature|bugfix|hotfix|fix|chore|docs|refactor|test)\///')

    # Remove any remaining slashes (convert to dashes)
    feature=$(echo "$feature" | tr '/' '-')

    echo "${default_branch}.${feature}"
}

_wt_help() {
    cat << 'EOF'
wt - Git worktree + tmux window for feature development

USAGE: wt [flags] <feature-name>

Branch names are normalized to <default>.<feature> format:
    wt foobar           → main.foobar
    wt feature/foobar   → main.foobar
    wt main.foobar      → main.foobar (unchanged)

FLAGS:
    -n, --new       Create new branch from default branch
    -c, --checkout  Checkout existing branch
    -d, --delete    Delete worktree and tmux window
    -l, --list      List all worktrees
    -h, --help      Show help

EXAMPLES:
    wt new-api            # Creates main.new-api branch + worktree + tmux window
    wt -c main.bugfix     # Checkout existing branch
    wt -d old-feature     # Delete worktree for main.old-feature

LAYOUT (new tmux window in current session):
    +------------------+------------------+
    |     claude       |      shell       |
    +------------------+------------------+

CLEANUP: wt-clean (removes worktrees for gone branches)

NOTE: Must be run inside tmux.
EOF
}

_wt_get_default_branch() {
    git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' ||
    git config --get init.defaultBranch 2>/dev/null ||
    { git show-ref --verify --quiet refs/heads/main && echo "main" || echo "master"; }
}

_wt_create() {
    local branch="$1" worktree_path="$2" window_name="$3" force_new="$4" force_checkout="$5" repo_root="$6" default_branch="$7"

    if [[ -d "$worktree_path" ]]; then
        echo "Worktree exists at: $worktree_path"
        # Try to switch to existing window
        _wt_create_session "$window_name" "$worktree_path"
        return 0
    fi

    mkdir -p "$HOME/src/worktrees"

    local branch_exists=false
    git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null && branch_exists=true
    git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null && branch_exists=true

    if $branch_exists && ! $force_new; then
        echo "Creating worktree for existing branch: $branch"
        git worktree add "$worktree_path" "$branch" || return 1
    elif ! $branch_exists && $force_checkout; then
        echo "Error: Branch '$branch' does not exist" >&2
        return 1
    else
        echo "Creating worktree with new branch: $branch (from $default_branch)"
        git worktree add -b "$branch" "$worktree_path" "$default_branch" || return 1
    fi

    echo "Worktree created at: $worktree_path"
    _wt_create_session "$window_name" "$worktree_path"
}

_wt_create_session() {
    local window_name="$1" worktree_path="$2"

    # Must be inside tmux to create a window
    if [[ -z "$TMUX" ]]; then
        echo "Error: Must be inside tmux to create worktree window" >&2
        echo "Start tmux first, then run wt again" >&2
        return 1
    fi

    # Check if window already exists in current session
    local current_session
    current_session=$(tmux display-message -p '#S')

    if tmux list-windows -t "$current_session" -F '#W' | grep -q "^${window_name}$"; then
        echo "Window '$window_name' already exists, switching to it"
        tmux select-window -t "${current_session}:${window_name}"
        return 0
    fi

    # Create new window with two vertical splits
    # Left pane: claude CLI (with nvm)
    # Right pane: shell
    tmux new-window -n "$window_name" -c "$worktree_path"
    tmux split-window -t "${current_session}:${window_name}" -h -c "$worktree_path"

    # Left pane (0): run nvm use --lts then claude
    tmux send-keys -t "${current_session}:${window_name}.0" "nvm use --lts && claude" C-m

    # Right pane (1): clear and show status
    tmux send-keys -t "${current_session}:${window_name}.1" "clear && git status" C-m

    # Select left pane (claude)
    tmux select-pane -t "${current_session}:${window_name}.0"
}

_wt_delete() {
    local worktree_path="$1" branch="$2" window_name="$3"

    # Kill tmux window if it exists (in current session)
    if [[ -n "$TMUX" ]]; then
        local current_session
        current_session=$(tmux display-message -p '#S')
        if tmux list-windows -t "$current_session" -F '#W' | grep -q "^${window_name}$"; then
            echo "Killing tmux window: $window_name"
            tmux kill-window -t "${current_session}:${window_name}" 2>/dev/null
        fi
    fi

    [[ -d "$worktree_path" ]] && {
        echo "Removing worktree: $worktree_path"
        git worktree remove "$worktree_path" --force
    } || echo "Worktree not found at: $worktree_path"

    echo ""
    echo -n "Delete branch '$branch' as well? [y/N] "
    read -r REPLY
    [[ $REPLY =~ ^[Yy]$ ]] && git branch -D "$branch" 2>/dev/null || true

    git worktree prune
}

# Cleanup worktrees for branches gone from remote
wt-clean() {
    local worktrees_dir="$HOME/src/worktrees"
    [[ ! -d "$worktrees_dir" ]] && { echo "No worktrees at: $worktrees_dir"; return 0; }

    echo "Fetching and checking for stale worktrees..."
    git rev-parse --is-inside-work-tree &>/dev/null && git fetch -p

    local cleaned=0
    local current_session=""
    [[ -n "$TMUX" ]] && current_session=$(tmux display-message -p '#S')

    for wt_dir in "$worktrees_dir"/*; do
        [[ -d "$wt_dir" && -f "$wt_dir/.git" ]] || continue

        local branch upstream_status
        branch=$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD 2>/dev/null) || continue
        upstream_status=$(git -C "$wt_dir" for-each-ref --format='%(upstream:track)' "refs/heads/$branch" 2>/dev/null)

        if [[ "$upstream_status" == "[gone]" ]]; then
            # Window name: feature part of branch (after the dot)
            local window_name="${branch#*.}"

            echo "Stale: $wt_dir (branch: $branch)"
            echo -n "Remove worktree and kill window? [y/N] "
            read -r REPLY
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                # Kill tmux window if exists
                if [[ -n "$current_session" ]]; then
                    tmux kill-window -t "${current_session}:${window_name}" 2>/dev/null
                fi
                git -C "$wt_dir" worktree remove "$wt_dir" --force 2>/dev/null || rm -rf "$wt_dir"
                ((cleaned++))
            fi
        fi
    done

    git rev-parse --is-inside-work-tree &>/dev/null && { git worktree prune; git gone; }
    echo "Cleaned $cleaned worktree(s)"
}

# ============================================================================
# Local/Private Configuration
# ============================================================================

# Source local aliases and functions not tracked in git
# Create ~/.shell_local for machine-specific or private configs
[ -f ~/.shell_local ] && source ~/.shell_local
